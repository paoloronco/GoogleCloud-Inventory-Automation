name: GCP Inventory v2
on:
  workflow_dispatch:
    inputs:
      deep:
        description: "Include deeper configuration checks"
        type: boolean
        default: true
  schedule:
    - cron: "17 6 * * *"
    - cron: "43 7 * * 0"
permissions:
  contents: read
  id-token: write
concurrency:
  group: gcp-inventory-v2
  cancel-in-progress: false
jobs:
  collect:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        identity: [account-a, account-b]
    steps:
      - uses: actions/checkout@v4
      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets[format('GCP_WIF_PROVIDER_{0}', matrix.identity == 'account-a' && 'A' || 'B')] }}
          service_account: ${{ secrets[format('GCP_SERVICE_ACCOUNT_{0}', matrix.identity == 'account-a' && 'A' || 'B')] }}
      - uses: google-github-actions/setup-gcloud@v2
      - name: Collect
        shell: bash
        run: |
          DEEP=""
          if [[ "${{ github.event.schedule }}" == "43 7 * * 0" || "${{ inputs.deep }}" == "true" ]]; then DEEP="--deep"; fi
          python3 inventory/collect.py --identity "${{ matrix.identity }}" --out "output" $DEEP
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: inventory-${{ matrix.identity }}
          path: output/
          if-no-files-found: warn
